# 에이전트리아 배포 어빌리티 엔드포인트
AGENTRIA_API_URL=
AGENTRIA_API_KEY=

# 에이전트리아 Ability API는 X-API-KEY 헤더를 사용합니다.
# API URL 예시: https://ability-worker.agentria.io/api/ability/onul-fit-main

# 오늘핏 옷장 저장 Ability API
AGENTRIA_WARDROBE_API_URL=
# 비워두면 AGENTRIA_API_KEY를 함께 사용합니다.
AGENTRIA_WARDROBE_API_KEY=

# 공공데이터포털에서 발급받은 서비스별 인증키(Decoding)
KMA_FORECAST_SERVICE_KEY=
KMA_UV_SERVICE_KEY=
KMA_WARNING_SERVICE_KEY=

# 같은 키를 사용하는 경우에만 사용할 수 있는 기존 호환 변수
KMA_SERVICE_KEY=
